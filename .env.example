DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database
JWT_SECRET_KEY=replace-with-a-long-random-secret
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
RECOVERY_CONFIDENCE_THRESHOLD=0.55
RECOVERY_MAX_ATTEMPTS=3

# Razorpay test-mode keys (rzp_test_...). Used to create real Payment
# Links (test mode, no real money) for recovery outreach.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: configure these only when agent-generated emails should be sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
FRONTEND_URL=
